# Force pnpm as package manager
# This will show warnings if someone tries to use npm or yarn
# engine-strict=true  # Disabled: api-customer needs Node 20, but other services need Node 22
engine-strict=false

# Auto-install peers
auto-install-peers=true

# Shamefully hoist (helps with some compatibility issues)
shamefully-hoist=true

# Use workspace protocol for local packages
link-workspace-packages=true
