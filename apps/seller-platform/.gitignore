# Node artifact files
node_modules/
dist/
.env
.next

next-env.d.ts


.next/
.env

next-env.d.ts
# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Playwright test results and reports
test-results/
playwright-report/

# Personal Claude Code settings (auto-ignored by Claude, but listed for clarity)
# Note: *.local.* files are automatically gitignored by Claude Code
.claude/CLAUDE.local.md
.claude/settings.local.json
.claude/memory/
.claude/worktrees/
