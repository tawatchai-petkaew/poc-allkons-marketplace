# ============================================
# Allkons Marketplace B2C - Environment Variables
# ============================================
# Copy this file to .env.local and update the values

# --------------------------------------------
# API Configuration
# --------------------------------------------

# Main API Gateway URL (used when not using local services)
NEXT_PUBLIC_API_HOST_URL=https://marketplace-api-dev.allkons.com

# App ID for Allkons services
NEXT_PUBLIC_ALLKONS_APP_ID=44776641-5750-4b66-988a-d9f2c2e162c6

# --------------------------------------------
# Proxy Configuration
# --------------------------------------------

# NOTE: Client-side requests ALWAYS use Next.js proxy (/api/*) automatically
# This is required because the backend sets httpOnly cookies that browser must accept
# Server-side requests (SSR, Server Actions) call backend directly for performance

# Server-side only: Internal API host (used by proxy, not exposed to client)
# Use this if your backend has a different internal URL for server-to-server calls
# INTERNAL_API_HOST=http://internal-api.local

# --------------------------------------------
# How It Works
# --------------------------------------------
# Client-side requests (browser)
#    → ALWAYS use Next.js proxy: /api/customer, /api/product, /api/order
#    → Proxy forwards to: NEXT_PUBLIC_API_HOST_URL/api-{service}
#    → Required for httpOnly cookies to work properly
#
# Server-side requests (SSR, Server Components, Server Actions)
#    → Call backend directly: https://marketplace-api-dev.allkons.com/api-customer
#    → Bypass proxy for better performance
#    → Uses INTERNAL_API_HOST if set, otherwise NEXT_PUBLIC_API_HOST_URL
#
# Why proxy is required for client-side:
# - Backend sets httpOnly cookies (accessToken, refreshToken) for security
# - Browser only accepts Set-Cookie from same-origin responses
# - Without proxy, cross-origin Set-Cookie headers are blocked
#
# Examples:
# - Client: axios.get() → /api/customer/auth → Next.js proxy → backend → Set-Cookie works ✓
# - Server: axios.get() → https://marketplace-api-dev.allkons.com/api-customer/auth (direct)
