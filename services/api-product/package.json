{
  "name": "@allkons/api-product",
  "version": "2.22.10",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=22.10.0 <23.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "run:dev": "ENV_FILE=.env.develop COMMAND='pnpm start:dev' docker-compose up",
    "run:staging": "ENV_FILE=.env.staging COMMAND='pnpm start:dev' docker-compose up api",
    "build:dev": "ENV_FILE=.env.develop COMMAND='pnpm typeorm:migration:run && pnpm start:dev' docker-compose up --build api",
    "build:staging": "ENV_FILE=.env.staging COMMAND='pnpm start:dev' docker-compose up --build api",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm:migration:generate": "pnpm typeorm migration:generate -d src/config/data-source.ts",
    "typeorm:migration:run": "pnpm typeorm migration:run -d src/config/data-source.ts",
    "typeorm:migration:revert": "pnpm typeorm migration:revert -d src/config/data-source.ts",
    "start:dev:db:seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "start:dev:db:seed:permissions": "ts-node -r tsconfig-paths/register src/scripts/seed-permissions.ts",
    "start:dev:db:seed:role-permissions": "ts-node -r tsconfig-paths/register src/scripts/seed-role-permissions.ts",
    "start:prod:db:seed:roles": "node dist/scripts/seed-roles.js",
    "start:prod:db:seed:permissions": "node dist/scripts/seed-permissions.js",
    "start:prod:db:seed:role-permissions": "node dist/scripts/seed-role-permissions.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:migration:run": "docker exec -it `docker ps -q --filter ancestor=shopdit-api` sh -c 'pnpm typeorm:migration:run'",
    "docker:migration:generate": "docker exec -it `docker ps -q --filter ancestor=shopdit-api` pnpm typeorm:migration:generate",
    "docker:migration:revert": "docker exec -it `docker ps -q --filter ancestor=shopdit-api` pnpm typeorm:migration:revert",
    "repl": "nest start --entryFile repl"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@aws-sdk/lib-storage": "^3.943.0",
    "@aws-sdk/s3-request-presigner": "^3.943.0",
    "@bull-board/api": "^5.14.1",
    "@bull-board/express": "^5.14.1",
    "@bull-board/nestjs": "^5.14.1",
    "@elastic/elasticsearch": "^8.12.0",
    "@jm18457/kafkajs-msk-iam-authentication-mechanism": "^3.1.2",
    "@keyv/redis": "^3.0.1",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.7",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.56.1",
    "@opentelemetry/sdk-node": "0.57.2",
    "@types/body-parser": "^1.19.6",
    "@types/bull": "^3.15.8",
    "@types/multer": "^1.4.6",
    "allkons-api-helper": "git+ssh://git@bitbucket.org/ThammasornDEV/allkons-api-helper.git#v1.0.2",
    "asyncctx": "^2.0.16",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.2",
    "bull": "^4.8.3",
    "cache-manager": "^6.3.2",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express-basic-auth": "^1.2.1",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.0",
    "kafkajs": "^2.2.4",
    "keyv": "^5.2.3",
    "nestjs-i18n": "^10.5.0",
    "nestjs-typeorm-paginate": "^4.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "swagger-ui-express": "^5.0.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tunnel-ssh": "^5.2.0",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^10.6.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.48.1",
    "webpack": "^5.103.0",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".(service|controller)*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.controller.ts",
      "**/*.service.ts",
      "!**/flash-sale-public.service.spec.ts",
      "!**/flash-sale-public.controller.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
