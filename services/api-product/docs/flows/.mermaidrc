{
  "theme": "default",
  "themeVariables": {
    "primaryColor": "#4f46e5",
    "primaryTextColor": "#ffffff",
    "primaryBorderColor": "#3730a3",
    "lineColor": "#6b7280",
    "secondaryColor": "#f0fdf4",
    "tertiaryColor": "#ecfeff",
    "errorBkgColor": "#fef2f2",
    "errorTextColor": "#dc2626"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "basis",
    "diagramPadding": 20,
    "nodeSpacing": 50,
    "rankSpacing": 50
  },
  "sequence": {
    "diagramMarginX": 50,
    "diagramMarginY": 10,
    "actorMargin": 50,
    "width": 150,
    "height": 65,
    "boxMargin": 10,
    "boxTextMargin": 5,
    "noteMargin": 10,
    "messageMargin": 35
  }
}
