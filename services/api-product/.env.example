# ====================================
# API Product Service - Environment Configuration
# ====================================
# Copy this file to .env and fill in the actual values

# Environment
MODE=DEV
NODE_ENV=development
ENV_TYPE=dev

# Server Configuration
PORT=4002

# ====================================
# Database Configuration
# ====================================

# PostgreSQL via SSH Tunnel (Recommended for local development)
IS_ENABLE_SSH_TUNNEL=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15402
SSH_TUNNEL_PORT=15402
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DATABASE=allkons_marketplace_dev

# Alternative: Direct Connection to AWS RDS (Requires VPN/IP whitelisting)
# IS_ENABLE_SSH_TUNNEL=false
# POSTGRES_HOST=rds-psql-apse1-allkons-dev.cbciy6k28x4s.ap-southeast-1.rds.amazonaws.com
# POSTGRES_PORT=5432
# POSTGRES_USER=your_db_user
# POSTGRES_PASSWORD=your_db_password
# POSTGRES_DATABASE=allkons_marketplace_dev

# Alternative: Local Docker PostgreSQL
# IS_ENABLE_SSH_TUNNEL=false
# POSTGRES_HOST=localhost
# POSTGRES_PORT=20000
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=mysecretpassword
# POSTGRES_DATABASE=shopdit_api_development

# ====================================
# Authentication
# ====================================
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# Auth Center Configuration
AUTH_CENTER_URL=https://auth-service-dev.allkons.com
AUTH_CLIENT_ID=allkons-marketplace
AUTH_CLIENT_SECRET=your_auth_client_secret
AUTH_CENTER_JWKS_URI=https://keycloak-dev.allkons.com/realms/allkons/protocol/openid-connect/certs

# ====================================
# AWS Services
# ====================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_S3_BUCKET=s3-apse1-allkons-dev
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_REGION=ap-southeast-1

# ====================================
# Redis
# ====================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ====================================
# Application IDs
# ====================================
APP_ID_SELLER=your_seller_app_id
APP_ID_BUYER=your_buyer_app_id

# ====================================
# Kafka Message Queue
# ====================================
KAFKA_REGION=ap-southeast-1
KAFKA_ACCESS_KEY=your_kafka_access_key
KAFKA_SECRET_KEY=your_kafka_secret_key
KAFKA_MECHANISM=AWS_MSK_IAM
KAFKA_BROKER1=your_kafka_broker_1_url
KAFKA_BROKER2=your_kafka_broker_2_url
KAFKA_CONSUMER=nestjs-consumer-group-dev

# ====================================
# Elasticsearch
# ====================================
ELASTICSEARCH_URI=https://your-elasticsearch-uri.elastic-cloud.com/
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key
ELASTICSEARCH_INDEX_PREFIX=dev-allkons-search

# ====================================
# Product Matching Service
# ====================================
PRODUCT_MATCHING_API_URL=https://product-matching-dev.allkons.com/api/v1
PRODUCT_MATCHING_API_KEY=your_product_matching_api_key

# ====================================
# Basic Auth for Admin Tools
# ====================================
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=your_swagger_password
BULLBOARD_USER=admin
BULLBOARD_PASS=your_bullboard_password

# Bull Board Base Path (for reverse proxy deployment)
# Local: leave empty
# Production/Staging: set to '/api-product' (with leading slash, no trailing slash)
BULL_BOARD_BASE_PATH=
