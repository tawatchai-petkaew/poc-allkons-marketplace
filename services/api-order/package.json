{
  "name": "@allkons/api-order",
  "version": "2.22.10",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "run:dev": "ENV_FILE=.env.develop COMMAND='pnpm start:dev' docker-compose up",
    "run:staging": "ENV_FILE=.env.staging COMMAND='pnpm start:dev' docker-compose up api",
    "build:dev": "ENV_FILE=.env.develop COMMAND='pnpm add @nestjs/schedule && pnpm pretypeorm && pnpm typeorm:migration:run && pnpm start:dev' docker-compose up --build api",
    "build:staging": "ENV_FILE=.env.staging COMMAND='pnpm pretypeorm && pnpm start:dev' docker-compose up --build api",
    "pretypeorm": "(rm -rf ormconfig.json || :) && node dist/scripts/write-type-orm-config.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm:migration:generate": "pnpm typeorm -- migration:generate -n",
    "typeorm:migration:run": "pnpm typeorm -- migration:run",
    "typeorm:migration:revert": "pnpm typeorm -- migration:revert",
    "start:dev:db:seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "start:dev:db:seed:permissions": "ts-node -r tsconfig-paths/register src/scripts/seed-permissions.ts",
    "start:dev:db:seed:role-permissions": "ts-node -r tsconfig-paths/register src/scripts/seed-role-permissions.ts",
    "start:prod:db:seed:roles": "node dist/scripts/seed-roles.js",
    "start:prod:db:seed:permissions": "node dist/scripts/seed-permissions.js",
    "start:prod:db:seed:role-permissions": "node dist/scripts/seed-role-permissions.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:migration:run": "docker exec -it `docker ps -q --filter ancestor=marketplace-api-order` sh -c 'pnpm typeorm:migration:run'",
    "docker:migration:generate": "docker exec -it `docker ps -q --filter ancestor=marketplace-api-order` pnpm typeorm:migration:generate",
    "docker:migration:revert": "docker exec -it `docker ps -q --filter ancestor=marketplace-api-order` pnpm typeorm:migration:revert",
    "test:shopee": "jest src/modules/shopee/*",
    "repl": "nest start --entryFile repl"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "@aws-sdk/s3-request-presigner": "^3.946.0",
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@keyv/redis": "^5.1.4",
    "@nestjs-modules/mailer": "^1.6.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bull": "^11.0.0",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.56.1",
    "@opentelemetry/sdk-node": "0.57.2",
    "@prisma/client": "5.8.1",
    "@sentry/node": "^7.63.0",
    "@sentry/tracing": "^7.34.0",
    "@shopee-sdk": "https://github.com/realroy/shopee-sdk#ac461b700808fe08cf9d394c3bc6b4b68777191b",
    "@types/body-parser": "^1.19.6",
    "@types/bull": "^3.15.8",
    "@types/cron": "^1.7.3",
    "@types/form-data": "^2.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.6",
    "allkons-api-helper": "git+ssh://git@bitbucket.org/ThammasornDEV/allkons-api-helper.git#v1.0.0",
    "api": "^6.1.1",
    "asyncctx": "^2.0.16",
    "axios": "^1.2.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.2",
    "bull": "^4.8.3",
    "cache-manager": "^6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.18",
    "dotenv": "^8.2.0",
    "form-data": "^4.0.5",
    "handlebars": "^4.7.7",
    "jsonwebtoken": "^9.0.3",
    "keyv": "^5.5.4",
    "libphonenumber-js": "^1.12.9",
    "lodash": "^4.17.21",
    "nestjs-i18n": "^10.5.0",
    "nodemailer": "^6.7.0",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "pg": "^8.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7",
    "swagger-ui-express": "^5.0.0",
    "tunnel-ssh": "^5.2.0",
    "typeorm": "^0.3.27",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^10.6.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/bull": "^3.15.8",
    "@types/cron": "^1.7.3",
    "@types/crypto-js": "^4.1.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.195",
    "@types/multer": "^1.4.6",
    "@types/node": "^22.10.5",
    "@types/node-fetch": "2.6.4",
    "@types/passport-jwt": "^3.0.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "jest": "^29.7.0",
    "nodemon": "^2.0.7",
    "prettier": "^2.2.1",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.1.2",
    "typescript": "^5.0.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!migration/**",
      "!scripts/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
