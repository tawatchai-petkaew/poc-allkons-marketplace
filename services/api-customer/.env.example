# ====================================
# API Customer Service - Environment Configuration
# ====================================
# Copy this file to .env and fill in the actual values

# Environment
MODE=DEV
NODE_ENV=development
ENV_TYPE=dev

# Server Configuration
PORT=4000

# ====================================
# Database Configuration
# ====================================

# PostgreSQL via SSH Tunnel (Recommended for local development)
IS_ENABLE_SSH_TUNNEL=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15400
SSH_TUNNEL_PORT=15400
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DATABASE=allkons_marketplace_dev

# Alternative: Direct Connection to AWS RDS (Requires VPN/IP whitelisting)
# IS_ENABLE_SSH_TUNNEL=false
# POSTGRES_HOST=rds-psql-apse1-allkons-dev.cbciy6k28x4s.ap-southeast-1.rds.amazonaws.com
# POSTGRES_PORT=5432
# POSTGRES_USER=your_db_user
# POSTGRES_PASSWORD=your_db_password
# POSTGRES_DATABASE=allkons_marketplace_dev

# Alternative: Local Docker PostgreSQL
# IS_ENABLE_SSH_TUNNEL=false
# POSTGRES_HOST=localhost
# POSTGRES_PORT=20000
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=mysecretpassword
# POSTGRES_DATABASE=allkons_marketplace_local

# ====================================
# Authentication
# ====================================
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# Auth Center Configuration
AUTH_CENTER_URL=https://auth-service-dev.allkons.com
AUTH_CLIENT_ID=allkons-marketplace
AUTH_CLIENT_SECRET=your_auth_client_secret
MARKETPLACE_CLIENT_ID=allkons-marketplace
MARKETPLACE_CLIENT_SECRET=your_marketplace_client_secret
AUTH_CENTER_JWKS_URI=https://keycloak-dev.allkons.com/realms/allkons/protocol/openid-connect/certs

# ====================================
# AWS Services
# ====================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_S3_BUCKET=s3-apse1-allkons-dev/allkons_m
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_REGION=ap-southeast-1

# ====================================
# Redis
# ====================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CRON_SUBDOMAIN=0 0 0 * * *

# ====================================
# Email/Mailer Configuration
# ====================================
ALLKONS_MAILER_PORT=25
ALLKONS_MAILER_HOST=mail.example.com
ALLKONS_MAILER_USER=noreply-dev@allkons.com
ALLKONS_MAILER_PASSWORD=your_mailer_password
ALLKONS_MAIL_FROM_NAME=Allkons
ALLKONS_MAIL_FROM_ADDRESS=noreply-dev@allkons.com
ALLKONS_MAIL_ADMIN_CIS=admin@allkons.com

# ====================================
# SMS Providers
# ====================================
# Thai SMS
OTP_KEY=your_otp_key
OTP_SECRET=your_otp_secret

# 8x8 SMS
SMS_SUB_ACCOUNT_ID=your_sms_sub_account_id
SMS_KEY=your_sms_key

# Thai Bulk SMS
THAIBULKSMS_BASE_URL=https://api-v2.thaibulksms.com
THAIBULKSMS_API_KEY=your_api_key
THAIBULKSMS_API_SECRET=your_api_secret
THAIBULKSMS_SENDER=Allkons

# ====================================
# External Services Integration
# ====================================
# CIS360 Integration
CIS_URL=https://cis360-api-dev.allkons.com/ak-cis360-api-dev
CIS_API_KEY=your_cis_api_key
CIS_PLATFORM_SELLER_KEY=your_platform_seller_key
CIS_PLATFORM_BUYER_KEY=your_platform_buyer_key
APP_ID_SELLER=your_seller_app_id
APP_ID_BUYER=your_buyer_app_id
APP_ID_MARKETPLACE=your_marketplace_app_id

# Ksher Payment Gateway
KSHER_HOST=https://sshopdit.vip.ksher.net
KSHER_TOKEN=your_ksher_token

# Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# ====================================
# E-commerce Platform Integrations
# ====================================
# TikTok Shop
TIK_TOK_APP_KEY=your_tiktok_app_key
TIK_TOK_APP_SECRET=your_tiktok_app_secret
TIK_TOK_AUTH_API=https://auth-sandbox.tiktok-shops.com/api
TIK_TOK_OPEN_API=https://open-api-sandbox.tiktokglobalshop.com/api
TIK_TOK_OAUTH=https://auth-sandbox.tiktok-shops.com/oauth/authorize

# Lazada
LAZADA_APP_KEY=your_lazada_app_key
LAZADA_APP_SECRET=your_lazada_app_secret
LAZADA_OAUTH=https://auth.lazada.com/oauth/authorize
LAZADA_OPEN_API=https://api.lazada.co.th/rest

# Shopee
SHOPEE_PARTNER_ID=your_shopee_partner_id
SHOPEE_PARTNER_KEY=your_shopee_partner_key
SHOPEE_REDIRECT_BASE_URL=https://api.staging.shopdit.com/shopee/callback
SHOPEE_API_BASE_URL=https://partner.test-stable.shopeemobile.com
SHOPDIT_SHOPEE_PRODUCT_LIST_URL=https://portal.staging.shopdit.com/callback/shopee

# ====================================
# Apple Services
# ====================================
APPLE_LOG_IN_CLIENT_ID=com.shopdit.app
APPLE_LOG_IN_TEAM_ID=your_apple_team_id
APPLE_LOG_IN_KEY_ID=your_apple_key_id
APPLE_LOG_IN_FILE_NAME_KEY_ID=AuthKey_your_key_id

# ====================================
# Security & Tokens
# ====================================
REGISTER_TOKEN=your_register_token
CREATE_MERCHANT_TOKEN=your_create_merchant_token
ENCRYPTION_KEY=your_encryption_key_64_characters_hex

# ====================================
# Kafka Message Queue
# ====================================
KAFKA_REGION=ap-southeast-1
KAFKA_ACCESS_KEY=your_kafka_access_key
KAFKA_SECRET_KEY=your_kafka_secret_key
KAFKA_MECHANISM=AWS_MSK_IAM
KAFKA_BROKER1=your_kafka_broker_1_url
KAFKA_BROKER2=your_kafka_broker_2_url
KAFKA_CONSUMER=nestjs-consumer-group-dev

# Message Queue Configuration
DELAY_RETRY=3000

# ====================================
# Monitoring & Debugging
# ====================================
SENTRY_DSN=your_sentry_dsn_url

# ====================================
# Demo/Test Data
# ====================================
DEMO_MERCHANT_SLUG=shopdit
DEMO_ACCOUNT_ID=103
MOCK_EMAIL_OTP_SUCCESS=true

# ====================================
# Portal URL
# ====================================
PORTAL_HOST_URL=https://portal.staging.shopdit.com/
