    "@typescript-eslint/parser": "^4.19.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "jest": "^29.7.0",
    "prettier": "^2.2.1",
    "supertest": "^6.1.3",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.4.2",
    "ts-node": "10.9.1",
    "typescript": "5.0.4",
    "webpack": "^5.103.0",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.controller.{ts,tsx,js,jsx}",
      "**/*.service.{ts,tsx,js,jsx}",
      "!**/*.dto.{ts,tsx,js,jsx}",
      "!**/*.module.{ts,tsx,js,jsx}",
      "!**/main.{ts,js}",
      "!**/*.spec.{ts,tsx,js,jsx}",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/dist/**",
      "!**/*.config.{ts,js}"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
